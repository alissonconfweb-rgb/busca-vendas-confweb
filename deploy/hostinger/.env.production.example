APP_DOMAIN=buscavendas.confweb.com.br
ACME_EMAIL=alisson.confweb@gmail.com

PUBLIC_URL=https://buscavendas.confweb.com.br
FRONTEND_ORIGIN=https://buscavendas.confweb.com.br
CREATOR_EMAIL=alisson.confweb@gmail.com
ADMIN_NAME=Alisson Confweb
ADMIN_EMAIL=alisson.confweb@gmail.com

# Use apenas na primeira inicializacao de um banco vazio. Depois remova esta linha.
ADMIN_PASSWORD=troque-esta-senha

SESSION_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-64-caracteres
SETTINGS_ENCRYPTION_KEY=gere-outra-chave-aleatoria-com-pelo-menos-64-caracteres
SESSION_TTL_DAYS=90
SEARCH_RESPONSE_TIMEOUT_MS=85000
MARKET_CACHE_TTL_DAYS=7
MIN_CHAMPION_SALES=1000
MELI_SCRAPER_ENABLED=false
MELI_LOCAL_BROWSER_ENABLED=false

SCRAPEDO_ENABLED=true
SCRAPEDO_API_TOKEN=
SCRAPEDO_ENDPOINT=https://api.scrape.do/
SCRAPEDO_SEARCH_PAGES=2
SCRAPEDO_DETAIL_LIMIT=24
SCRAPEDO_TIMEOUT_MS=45000
SCRAPEDO_MAX_CONCURRENCY=4
# Reserva 10% dos 250.000 creditos do plano para testes e emergencias.
SCRAPEDO_MONTHLY_CREDIT_BUDGET=225000

ASAAS_ENABLED=true
# O painel detecta Sandbox ou Producao pela chave e atualiza estas configuracoes.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENDPOINT=https://api-sandbox.asaas.com/v3
