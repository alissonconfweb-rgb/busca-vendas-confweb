# Copie este arquivo para .env em desenvolvimento local.
# Nunca suba .env real para o GitHub.

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# URL publica do frontend/backend em producao.
# Exemplo: https://busca-vendas.seudominio.com.br
PUBLIC_URL=
FRONTEND_ORIGIN=

# Dono/criador do projeto. Este e-mail sempre recebe acesso admin.
# Se ficar vazio, o sistema usa ADMIN_EMAIL como criador.
CREATOR_EMAIL=seu-email@dominio.com

# Admin inicial. O servidor cria/atualiza este usuario ao iniciar.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@dominio.com
ADMIN_PASSWORD=troque-esta-senha

# Gere strings longas e unicas para sessoes e para criptografar credenciais salvas.
# Exemplo no Node: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-uma-chave-longa
SETTINGS_ENCRYPTION_KEY=troque-por-outra-chave-longa
SESSION_TTL_DAYS=90

# Caminho do SQLite. Em producao com disco persistente, use algo como:
# DB_PATH=/var/data/busca-vendas.sqlite
DB_PATH=

# Prazo total da busca. O servidor aplica um teto de 75 segundos.
SEARCH_RESPONSE_TIMEOUT_MS=75000

# Playwright/Chromium. Em hospedagens com filesystem restrito, manter 0 instala no projeto.
PLAYWRIGHT_BROWSERS_PATH=0

# Mercado Livre OAuth opcional, mantido apenas para diagnostico administrativo.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=
MELI_SITE_ID=MLB
MELI_ACCESS_TOKEN=
MELI_REFRESH_TOKEN=
MELI_SCRAPER_ENABLED=false
MELI_LOCAL_BROWSER_ENABLED=false

# Motor local e proxy legado. Em cPanel compartilhado, mantenha desligado.
PROXY_ENABLED=false
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_COUNTRY=Brazil
PROXY_TIMEOUT_MS=30000
MIN_CHAMPION_SALES=1000
MARKET_CACHE_TTL_DAYS=7
MARKET_CACHE_REFRESH_INTERVAL_MS=21600000

# Scrape.do. Fonte principal e exclusiva para novas pesquisas e atualizacoes.
SCRAPEDO_ENABLED=true
SCRAPEDO_API_TOKEN=
SCRAPEDO_ENDPOINT=https://api.scrape.do/
SCRAPEDO_SEARCH_PAGES=1
SCRAPEDO_DETAIL_LIMIT=12
SCRAPEDO_TIMEOUT_MS=18000
SCRAPEDO_SEARCH_DEADLINE_MS=55000
SCRAPEDO_MAX_CONCURRENCY=4
SCRAPEDO_MONTHLY_CREDIT_BUDGET=225000

# Zyte API. Fallback legado opcional.
ZYTE_API_KEY=
ZYTE_ENDPOINT=https://api.zyte.com/v1/extract
# browser_html usa renderizacao; http_response e mais barato, mas pode falhar no Mercado Livre.
ZYTE_MODE=browser_html
ZYTE_SEARCH_ENABLED=false
ZYTE_SEARCH_PAGES=4
ZYTE_DETAIL_LIMIT=60
ZYTE_IP_TYPE=auto
ZYTE_GEOLOCATION=BR
ZYTE_TIMEOUT_MS=90000
ZYTE_CACHE_MS=43200000
ZYTE_STALE_CACHE_MS=129600000

# Asaas pagamentos. Use sandbox primeiro; producao exige chave prod.
ASAAS_ENABLED=true
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENDPOINT=https://api-sandbox.asaas.com/v3

# Oxylabs. Fallback legado opcional.
OXYLABS_ENABLED=false
OXYLABS_MODE=web_unblocker
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
OXYLABS_ENDPOINT=https://unblock.oxylabs.io:60000
OXYLABS_GEO_LOCATION=Brazil
OXYLABS_TIMEOUT_MS=120000
OXYLABS_RENDER_WAIT_SECONDS=5
OXYLABS_PRODUCT_LIMIT=3
